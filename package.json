{
  "name": "idwth",
  "version": "0.1.0",
  "private": true,
  "description": "IDWTH - Intent-Driven Web Test Harness (single-process CLI)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "idwth": "bin/idwth.js"
  },
  "files": [
    "dist",
    "src/cli/assets"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "bench:startup": "node scripts/bench-cli-startup.mjs",
    "pack:offline": "tsx scripts/build-offline-package.ts",
    "idwth": "tsx src/cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.64.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  }
}

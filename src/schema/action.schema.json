{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "idwth.schemas.action.v1",
  "title": "IDWTH Action (discriminated union)",
  "type": "object",
  "required": ["kind", "risk"],
  "additionalProperties": false,
  "properties": {
    "kind": { "enum": ["click", "fill", "select", "scroll", "wait", "navigate", "assert_only", "done"] },
    "risk": { "enum": ["reversible", "irreversible"] },
    "target": {
      "type": "object",
      "description": "ResolvedTarget (unified shape for L1/L2/L3)",
      "required": ["elementId", "strategy"],
      "properties": {
        "elementId": { "type": ["string", "integer"] },
        "strategy": { "enum": ["role", "label", "text", "fingerprint", "model"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "value": { "type": "string" },
    "deltaY": { "type": "number" },
    "ms": { "type": "integer", "minimum": 0 },
    "url": { "type": "string", "format": "uri" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "click" } } },
      "then": { "required": ["target"] }
    },
    {
      "if": { "properties": { "kind": { "const": "fill" } } },
      "then": { "required": ["target", "value"] }
    },
    {
      "if": { "properties": { "kind": { "const": "select" } } },
      "then": { "required": ["target", "value"] }
    },
    {
      "if": { "properties": { "kind": { "const": "scroll" } } },
      "then": { "required": ["deltaY"] }
    },
    {
      "if": { "properties": { "kind": { "const": "wait" } } },
      "then": { "required": ["ms"] }
    },
    {
      "if": { "properties": { "kind": { "const": "navigate" } } },
      "then": { "required": ["url"] }
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "idwth.schemas.contract.v1",
  "title": "IDWTH Test Contract",
  "type": "object",
  "required": ["version", "test", "environment", "identity", "goal", "steps", "assertions"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1" },
    "test": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "locale": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] }
      }
    },
    "environment": {
      "type": "object",
      "required": ["base_url"],
      "additionalProperties": false,
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "origins_allowlist": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "action_timeout_ms": { "type": "integer", "minimum": 1 },
        "assertion_deadline_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "identity": {
      "type": "object",
      "required": ["credentials_ref"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "credentials_ref": { "type": "string", "pattern": "^cred://" }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": true,
        "properties": {
          "kind": { "type": "string" }
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "goal": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["intent", "action", "risk"],
        "additionalProperties": false,
        "properties": {
          "intent": { "type": "string", "minLength": 1 },
          "action": { "enum": ["click", "fill", "select", "scroll", "wait", "navigate", "assert_only"] },
          "target": { "type": "string" },
          "value": { "type": "string" },
          "deltaY": { "type": "number" },
          "ms": { "type": "integer", "minimum": 0 },
          "url": { "type": "string", "format": "uri" },
          "risk": { "enum": ["reversible", "irreversible"] },
          "postcondition": { "type": "array", "items": { "type": "object" } }
        },
        "if": { "properties": { "risk": { "const": "irreversible" } } },
        "then": { "required": ["postcondition"] }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["visible", "absent", "count", "value", "checked", "url", "number"] }
            }
          }
        },
        "http": { "type": "array", "items": { "type": "object" } },
        "backend": { "type": "array", "items": { "type": "object" } },
        "state": { "type": "array", "items": { "type": "object" } }
      }
    },
    "cleanup": { "type": "array", "items": { "type": "object" } },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
